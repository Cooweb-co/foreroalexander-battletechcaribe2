# Copia este archivo a .env y completa tus credenciales.
# NUNCA subas el archivo .env al repositorio.

# Token del bot de Telegram (obtenlo con @BotFather)
TELEGRAM_BOT_TOKEN=

# OpenAI — categorización inteligente de gastos (opcional: hay fallback heurístico)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase — persistencia (opcional: hay fallback en memoria para desarrollo)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
